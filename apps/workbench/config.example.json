{
  "version": 1,
  "providers": [
    {
      "id": "my-provider",
      "api": "openai-completions",
      "baseUrl": "https://models.example/v1",
      "apiKeyEnv": "AGENT_API_KEY",
      "models": [
        {
          "id": "your-agent-model",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 128000,
          "maxTokens": 8192
        }
      ]
    }
  ],
  "agents": {
    "main": {
      "provider": "my-provider",
      "model": "your-agent-model",
      "thinking": "high"
    },
    "child": {
      "provider": "my-provider",
      "model": "your-agent-model",
      "thinking": "medium"
    }
  },
  "orchestration": {
    "maxOpenChildren": 4,
    "maxConcurrentJobs": 1,
    "maxQueuedJobs": 16,
    "maxContextBytes": 32768
  },
  "image": {
    "generation": {
      "baseUrl": "https://images.example/v1",
      "model": "your-image-model",
      "apiKeyEnv": "IMAGE_API_KEY"
    },
    "edit": {
      "baseUrl": "https://images.example/v1",
      "model": "your-image-edit-model",
      "apiKeyEnv": "IMAGE_API_KEY"
    },
    "promptEnhancer": {
      "baseUrl": "https://images.example/v1",
      "model": "your-prompt-enhancer",
      "apiKeyEnv": "IMAGE_API_KEY"
    }
  },
  "paths": {
    "workspace": "/path/to/DataEvolver",
    "python": "/path/to/venv/bin/python",
    "blender": "",
    "ue5": "",
    "ueProject": "",
    "assets": "",
    "datasets": "",
    "output": "/path/to/output"
  },
  "execution": {
    "target": "local",
    "sshHost": "",
    "remoteWorkspace": "",
    "remotePython": ".venv/bin/python",
    "remoteBlender": "",
    "remoteUe5": "",
    "remoteUeProject": "",
    "remoteAssets": "",
    "remoteDatasets": "",
    "remoteOutput": ".dataevolver/artifacts"
  },
  "pi": {
    "cli": "",
    "solExtension": "/path/to/SoL-Pi/src/sol-pi/index.ts"
  },
  "sol": {
    "enabled": true,
    "actionFusion": true,
    "observationPack": true,
    "evidencePreservingReducer": false,
    "onlineContextCompact": false,
    "cacheWriteReadRatio": 12.5,
    "reducerProvider": "",
    "reducerModel": ""
  }
}

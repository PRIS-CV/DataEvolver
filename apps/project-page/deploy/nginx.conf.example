# Include inside an existing HTTPS server block with a real domain/certificate.
# This sample intentionally does not create public listeners or TLS certificates.
location /api/ {
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    client_max_body_size 1k;
    limit_except GET HEAD OPTIONS { deny all; }
}

# Optional: serve the entire npm-built site alongside the API on the same host.
location / {
    root /aaaidata/dataevolver-project/apps/project-page/dist;
    index index.html;
    try_files $uri $uri/ =404;
}

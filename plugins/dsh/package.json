{
  "name": "dsh-dataevolver",
  "version": "0.1.0",
  "description": "Run DataEvolver image and 3D data synthesis workflows through DeepSeek Harness.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.mjs", "commands.mjs", "cordis.patch.yml", "config.example.patch.yml", "locale/*.json", "README*.md", "LICENSE"],
  "keywords": ["dsh-plugin", "dataevolver", "synthetic-data", "3d"],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.6-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.6-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.2-alpha.2"
  },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.6-alpha.1" }
}

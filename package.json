{
  "name": "dataevolver-project-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --watch services/trace-api/server.mjs --dev",
    "build": "node tooling/project-page/build.mjs",
    "preview": "node services/trace-api/server.mjs --static-only",
    "start": "node services/trace-api/server.mjs",
    "start:api": "node services/trace-api/server.mjs --api-only",
    "test": "node --test tooling/project-page/*.test.mjs services/trace-api/*.test.mjs web/traces/*.test.mjs",
    "deploy": "node tooling/project-page/deploy.mjs"
  }
}
